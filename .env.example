# Development-only fallback for API keys. The app itself stores keys in the OS keychain.
# Copy to .env and fill in the providers you want to use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
GEMINI_API_KEY=

# Optional: which provider/model the dev chat uses by default
PIYO_DEFAULT_PROVIDER=anthropic
PIYO_DEFAULT_MODEL=
